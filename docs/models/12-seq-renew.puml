@startuml seq-renew
' SD-03 Renew a loan (UC-07, includes UC-14)
skinparam shadowing false
autonumber
actor Member
boundary ":circulation_bp" as bp
control ":CirculationService" as circ
control ":ReservationService" as res
entity ":LoanRepository" as loans
entity ":CopyRepository" as copies
database ":Database" as db

Member -> bp : POST /loans/<loan_id>/renew
bp -> circ : renew(loan_id, actor = current user)
activate circ
circ -> db : transaction() begin
circ -> res : expire_holds()
circ -> loans : get(loan_id)
alt actor is a Member and loan belongs to someone else
  circ -> db : rollback
  circ --> bp : raise AccessDeniedError
  bp --> Member : HTTP 403
else own loan
  circ -> copies : get(loan.copy_id)
  circ -> res : has_waiting(copy.title_id, exclude_member_id = loan.member_id)
  alt renewal_count = 2, loan overdue, or title reserved by another member
    circ -> db : rollback
    circ --> bp : raise BusinessRuleError(message)
    bp --> Member : "Maximum renewals reached (2)" / ...
  else renewal allowed
    circ -> loans : update(due_date + 14, renewal_count + 1)
    circ -> db : commit
    circ --> bp : Loan
    bp --> Member : "Renewed, new due date 2026-12-29"
  end
end
deactivate circ
@enduml
